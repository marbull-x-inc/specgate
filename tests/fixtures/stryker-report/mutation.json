      "source": "export const BLOCKED = [\n  \"/blocked/a\",\n  \"/blocked/b\",\n];\n\n/** @guarantee ok.blocked a `path` in `BLOCKED` is blocked */\nexport function isBlocked(path: string): boolean {\n  return BLOCKED.includes(path);\n}\n\n/** @guarantee ok.adult an `age` of 18 or more is adult */\nexport function isAdult(age: number): boolean {\n  return check(age);\n}\n\nfunction check(age: number): boolean {\n  return age >= 18;\n}\n\n/** @guarantee ok.greets returns a greeting */\nexport function greet(name: string): string {\n  const text = `hi ${name}`;\n  return text;\n}\n\nexport class Pricing {\n  /** @guarantee ok.discount an order of 100 or more gets 10 off */\n  total(amount: number): number {\n    return this.discounted(amount);\n  }\n\n  private discounted(amount: number): number {\n    if (amount >= 100) return amount - 10;\n    return amount;\n  }\n}\n"
    }
  },
