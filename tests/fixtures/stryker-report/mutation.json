      "source": "import { expect, test } from \"vitest\";\nimport { Pricing, greet, isAdult, isBlocked } from \"../src/policy\";\n\ntest(\"isBlocked.ok.blocked\", () => {\n  expect(isBlocked(\"/blocked/a\")).toBe(true);\n});\n\ntest(\"isAdult.ok.adult\", () => {\n  expect(isAdult(30)).toBe(true);\n});\n\ntest(\"greet.ok.greets\", () => {\n  expect(typeof greet).toBe(\"function\");\n});\n\ntest(\"Pricing#total.ok.discount\", () => {\n  expect(new Pricing().total(200)).toBe(190);\n});\n"
    }
