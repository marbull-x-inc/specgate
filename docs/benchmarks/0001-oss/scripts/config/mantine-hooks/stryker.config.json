{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "packages/@mantine/hooks/src/use-counter/use-counter.ts",
    "packages/@mantine/hooks/src/use-disclosure/use-disclosure.ts",
    "packages/@mantine/hooks/src/use-toggle/use-toggle.ts",
    "packages/@mantine/hooks/src/use-pagination/use-pagination.ts",
    "packages/@mantine/hooks/src/use-queue/use-queue.ts",
    "packages/@mantine/hooks/src/use-os/use-os.ts"
  ],
  "reporters": [
    "json",
    "clear-text"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.ts",
    "config": {
      "roots": [
        "<rootDir>/packages/@mantine/hooks"
      ]
    }
  }
}
