{
  "surface": {
    "include": ["src/vanilla.ts", "src/vanilla/shallow.ts", "src/middleware/persist.ts"],
    "mode": "exported"
  },
  "tests": {
    "include": ["tests/**/*.test.ts", "tests/**/*.test.tsx"],
    "adapter": "vitest"
  },
  "tsdoc": {
    "jsdoc": true
  },
  "provenance": {
    "enabled": false
  },
  "output": {
    "dir": ".specgate-static"
  }
}
