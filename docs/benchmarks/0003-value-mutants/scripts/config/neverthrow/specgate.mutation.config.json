{
  "surface": {
    "include": ["src/result.ts"],
    "mode": "exported"
  },
  "tests": {
    "include": ["tests/**/*.test.ts"],
    "adapter": "vitest"
  },
  "tsdoc": {
    "jsdoc": true
  },
  "provenance": {
    "enabled": false
  },
  "output": {
    "dir": ".specgate-mutation"
  },
  "mutation": {
    "report": ["reports/mutation/mutation.json", "reports/value/value.json"]
  }
}
